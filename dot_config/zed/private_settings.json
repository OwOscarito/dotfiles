// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent": {
    "show_turn_stats": true,
    "tool_permissions": {
      "default": "confirm",
      "tools": {
        "edit_file": {
          "default": "allow"
        }
      }
    },
    "default_profile": "write",
    "profiles": {
      "terry": {
        "default_model": {
          "provider": "copilot_chat",
          "model": "claude-haiku-4.5",
          "enable_thinking": true
        },
        "name": "Terry",
        "tools": {
          "restore_file_from_disk": true,
          "save_file": true,
          "terminal": true,
          "spawn_agent": true,
          "read_file": true,
          "open": true,
          "now": true,
          "move_path": true,
          "grep": true,
          "list_directory": true,
          "find_path": true,
          "fetch": true,
          "edit_file": true,
          "diagnostics": true,
          "create_directory": true,
          "copy_path": true,
          "delete_path": false
        },
        "enable_all_context_servers": false,
        "context_servers": {}
      }
    },
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-4o",
      "enable_thinking": false
    },
    "favorite_models": [],
    "play_sound_when_agent_done": true,
    "model_parameters": []
  },
  "ssh_connections": [
    {
      "host": "10.14.14.11",
      "username": "owoscarito",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/owoscarito/.config/containers/./"
          ]
        }
      ],
      "nickname": "comet"
    }
  ],
  "edit_predictions": {
    "provider": "copilot"
  },
  "calls": {
    "mute_on_join": true,
  },
  "notification_panel": {
    "dock": "right",
  },
  "git_panel": {
    "tree_view": false,
  },
  "project_panel": {
    "indent_size": 15.0,
    "entry_spacing": "standard",
  },
  "tabs": {
    "show_diagnostics": "off",
    "file_icons": true,
    "git_status": true,
  },
  "status_bar": {
    "active_encoding_button": "enabled",
  },
  "disable_ai": false,
  "show_edit_predictions": false,
  "soft_wrap": "editor_width",
  "tab_size": 2,
  "gutter": {
    "min_line_number_digits": 3,
  },
  "debugger": {
    "stepping_granularity": "line",
    "dock": "left",
  },
  "title_bar": {
    "show_menus": false,
  },
  "window_decorations": "server",
  "ui_font_family": "Readex Pro",
  "buffer_font_family": "Maple Mono NF",
  "icon_theme": "Colored Zed Icons Theme Dark",
  "ui_font_size": 14.0,
  "buffer_font_size": 13,
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },
  "terminal": {
    "font_family": "Maple Mono NF",
    "font_size": 12.0,
    "toolbar": {
      "breadcrumbs": false,
    },
    "cursor_shape": "bar",
  },
  "format_on_save": "on",
  "formatter": "language_server",
  "lsp": {
    "tinymist": {
      "settings": {
        "exportPdf": "onSave",
        "outputPath": "$dir/$name",
      },
    },
  },
}
