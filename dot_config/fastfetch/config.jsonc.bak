{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small"
  },
  "general": {},
  "display": {
    "key": {
      "type": "both", // string, icon, both, or none
      "paddingLeft": 1,
      "width": 14
    }
  },
  "modules": [
    {
      "type": "title",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": ">----| Hardware |---->",
      "outputColor": "red"
    },
    {
      "type": "host",
      //"key": "    Host",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      //"key": "    CPU",
      "showPeCoreCount": true,
      "keyColor": "green",
      "temp": true
    },
    {
      "type": "gpu",
      //"key": "    GPU",
      "keyColor": "green",
      "temp": true
    },
    {
      "type": "display",
      "key": "Display",
      "keyColor": "green"
    },
    {
      "type": "memory",
      //"key": "    Memory",
      "keyColor": "green"
    },
    {
      "type": "swap",
      //"key": "    Swap",
      "keyColor": "green"
    },
    {
      "type": "disk",
      //"key": "    Disk",
      "keyColor": "green"
    },
    {
      "type": "localip",
      "key": "LAN IP",
      "showSpeed": true,
      "showAllIps": true,
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": ">----| Software |---->",
      "outputColor": "red"
    },
    {
      "type": "os",
      //"key": "    OS",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      //"key": "    Kernel",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      //"key": "  󰏖  Packages",
      "keyColor": "yellow"
    },
    {
      "type": "terminal",
      //"key": "    Terminal",
      "keyColor": "yellow"
    },
    {
      "type": "shell",
      //"key": "    Shell",
      "keyColor": "yellow"
    },
    {
      "type": "command",
      "key": "OS Age",
      "keyIcon": "",
      "keyColor": "yellow",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "uptime",
      //"key": "  Uptime",
      "keyColor": "yellow"
    },
    {
      "type": "custom",
      "format": ">----| Appearance |---->",
      "outputColor": "red"
    },
    {
      "type": "de",
      //"key": "    DE",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      //"key": "    WM",
      "keyColor": "blue"
    },
    {
      "type": "theme",
      //"key": "  󰉼  Theme",
      "keyColor": "blue"
    },
    {
      "type": "font",
      //"key": "    Font",
      "keyColor": "blue"
    },
    {
      "type": "terminalfont",
      "key": "TermFont",
      "keyColor": "blue"
    },
    {
      "type": "colors",
      "key": "Colors",
      "symbol": "circle",
      "keyColor": "blue"
    }
  ]
}
