{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/alolan-vulpix",
    "type": "file-raw",
    "padding": {
      "top": 2,
      "left": 1,
      "right": 1
    }
  },
  "display": {
    "key": {
      "type": "string", // string, icon, both, or none
      "width": 8
    },
    "disableLinewrap": false,
    "separator": " >",
    "temp": {
      "ndigits": 0,
      "unit": "C"
    }
  },
  "modules": [
    {
      "type": "title",
      "keyColor": "#f5e0dc"
    },
    "break",
    {
      "type": "os",
      "key": "OS  ",
      "keyColor": "#f2cdcd"
    },
    {
      "type": "kernel",
      "key": "KER ",
      "keyColor": "#f5c2e7"
    },
    {
      "type": "packages",
      "key": "PKGS",
      "keyColor": "#f38ba8"
    },
    {
      "type": "cpu",
      "key": "CPU ",
      "format": "{NAME} {FREQ-BASE}",
      "keyColor": "#eba0ac"
    },
    {
      "type": "gpu",
      "key": "GPU ",
      "keyColor": "#fab387"
    },
    {
      "type": "memory",
      "key": "MEM ",
      "keyColor": "#f9e2af"
    },
    {
      "type": "localip",
      "key": "IP  ",
      "showAllIps": true,
      "keyColor": "#a6e3a1"
    },
    {
      "type": "terminal",
      "key": "TERM",
      "keyColor": "#94e2d5"
    },
    {
      "type": "shell",
      "key": "SH  ",
      "keyColor": "#89dceb"
    },
    {
      "type": "uptime",
      "key": "UPT ",
      "keyColor": "#89b4fa"
    },
    {
      "type": "terminalfont",
      "key": "FONT",
      "keyColor": "#b4befe"
    }
  ]
}
