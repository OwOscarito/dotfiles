layout {

    focus-ring {
        active-color   "#94e2d5"
        inactive-color "#24273a"
        urgent-color   "#f38ba8"
    }

    border {
        active-color   "#94e2d5"
        inactive-color "#24273a"
        urgent-color   "#f38ba8"
    }

    shadow {
        color "#1e1e2e70"
    }

    tab-indicator {
        active-color   "#94e2d5"
        inactive-color "#1ba891"
        urgent-color   "#f38ba8"
    }

    insert-hint {
        color "#94e2d580"
    }
}

recent-windows {
    highlight {
        active-color "#94e2d5"
        urgent-color "#f38ba8"
    }
}


window-rule {
  match is-window-cast-target=true

  border {
    active-color "#f38ba8"
    inactive-color "#f38ba8"
  }
}
