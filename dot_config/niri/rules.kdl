// ────────────── Window Rules ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Window-Rules
window-rule {
  match app-id="."
  draw-border-with-background false
  }

// Full opacity clients
window-rule {
  match app-id="kitty"
  match app-id="foot"
  match app-id="footclient"
  opacity 1.0
}

// floating
window-rule {
  match app-id="org.gnome.FileRoller"
  baba-is-float true
}


window-rule {
  match title="^Picture-in-Picture$"
  match title="Picture in picture"
  open-floating true // Always float Firefox PiP windows
  opacity 0.9
  default-column-width { proportion 0.25; }
  default-window-height { proportion 0.25; }
}

// Block apps out password managers from screencasts.
window-rule {
  match app-id=r#"^org\.keepassxc\.KeePassXC$"#
  match app-id=r#"^org\.gnome\.World\.Secrets$"#

  block-out-from "screencast"
}

window-rule {
  match title="tui-dialog"
  open-floating true
  default-column-width { proportion 0.75; }
  default-window-height { proportion 0.75; }
}

/* Scratchpad support
window-rule {
    match app-id=r#"^spotify|nemo$"#
    open-on-workspace "scratch"
    open-floating true
    baba-is-float true
    default-column-width { proportion 0.75; }
    default-window-height { proportion 0.75; }
    opacity 0.9
}
*/
