// ────────────── Output Configuration ──────────────
// You can run `niri msg outputs` to get the correct name for your displays.
// You will have to remove "/-" and edit it before it takes effect.
// https://github.com/YaLTeR/niri/wiki/Configuration:-Outputs

output "eDP-1" {
    mode "1920x1080@60.020" // Set resolution and refresh rate
    scale 1.25 // No scaling (use 2 for HiDPI)
    position x=1920 y=1080
}

output "Samsung Electric Company LS24D300G H1AK500000" {
    scale 1
    position x=0 y=1080
}

output "HDMI-A-1" {
    scale 1
    position x=1920 y=0
}
